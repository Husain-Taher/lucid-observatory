# ==========================================
# LUCID BACKEND CONFIGURATION
# ==========================================

PROJECT_NAME="Lucid"
API_V1_STR="/api/v1"

# Database Connection
# Local Development (SQLite):
DATABASE_URL="sqlite+aiosqlite:///./lucid.db"
# Production (Neon / Supabase / DigitalOcean Managed Postgres with pgvector):
# DATABASE_URL="postgresql+asyncpg://lucid_user:YOUR_PASSWORD@ep-sample-123.us-east-2.aws.neon.tech/lucid?ssl=require"

# JWT Authentication Secret
SECRET_KEY="generate-a-strong-random-secret-here-for-production-use"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Free API Integrations (Optional / Fallback modes included):
# St. Louis Federal Reserve (Free: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=""

# Google Gemini API (Free tier: https://aistudio.google.com/)
GEMINI_API_KEY=""

# CORS Allowed Origins
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","https://*.vercel.app"]'
